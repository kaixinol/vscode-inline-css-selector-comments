{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Inline CSS Selector Comments",
  "scopeName": "inline.css-selector-comment",
  "injectionSelector": "L:source.js, L:source.ts, L:source.jsx, L:source.tsx",
  "patterns": [
    {
      "include": "#double-quoted"
    },
    {
      "include": "#single-quoted"
    },
    {
      "include": "#template-literal"
    }
  ],
  "repository": {
    "double-quoted": {
      "comment": "/* css selector */ \"...\" - region scoped as string.quoted.double.js so the body keeps the theme's string color; inner /* */ gets comment.block.css.inline-selector, which sits deeper in the stack and wins the comment color.",
      "name": "string.quoted.double.js",
      "begin": "(/\\*\\s*css[ -]selector\\s*\\*/)\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "comment.block.css"
        },
        "2": {
          "name": "punctuation.definition.string.begin.js"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.js"
        }
      },
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#inner-comment"
        }
      ]
    },
    "single-quoted": {
      "comment": "/* css selector */ '...' - same as double-quoted, single-quote variant.",
      "name": "string.quoted.single.js",
      "begin": "(/\\*\\s*css[ -]selector\\s*\\*/)\\s*(')",
      "beginCaptures": {
        "1": {
          "name": "comment.block.css"
        },
        "2": {
          "name": "punctuation.definition.string.begin.js"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.js"
        }
      },
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#inner-comment"
        }
      ]
    },
    "template-literal": {
      "comment": "/* css selector */ `...` - template literal variant, scoped as string.template.js.",
      "name": "string.template.js",
      "begin": "(/\\*\\s*css[ -]selector\\s*\\*/)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "comment.block.css"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.js"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.template.end.js"
        }
      },
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#inner-comment"
        }
      ]
    },
    "escape": {
      "comment": "Consume backslash escapes so they are not mistaken for the closing quote.",
      "match": "\\\\.",
      "name": "constant.character.escape"
    },
    "inner-comment": {
      "comment": "A /* ... */ block inside the string. Scoped as comment.block.css.inline-selector so it nests under the standard comment scopes (themes color it like a normal comment) while still being overridable via tokenColorCustomizations.",
      "name": "comment.block.css.inline-selector",
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.css"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.css"
        }
      }
    }
  }
}